# =======================================================
# QM-YWI Telegram Form Generator Bot Configuration
# =======================================================

# Token bot Telegram dari @BotFather (Wajib)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Telegram User ID owner/admin (Wajib untuk fitur /admin).
# Hanya ID ini yang dapat membuat token undangan, melihat pengguna, blokir, dsb.
# Bisa lebih dari satu, pisahkan dengan koma: 11111111,22222222
OWNER_TELEGRAM_ID=your_telegram_user_id_here

# Mode bot: 'polling' untuk testing lokal, atau 'webhook' untuk production
BOT_MODE=polling

# Konfigurasi Webhook Server (hanya jika mode webhook aktif)
PORT=3000
HOST=0.0.0.0
WEBHOOK_URL=https://your-domain.com/webhook
WEBHOOK_SECRET_TOKEN=your_random_secret_token_here

# =======================================================
# Persistence (SQLite bawaan Node, Node >= 22.5)
# =======================================================
# Lokasi file database. Gunakan ':memory:' untuk pengujian.
DB_PATH=./data/qmywi.sqlite

# Masa berlaku default token undangan (hari). 0 = tidak expired.
# Opsi expiry tetap dapat dipilih dari panel admin.
DEFAULT_TOKEN_TTL_DAYS=0
